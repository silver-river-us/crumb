#!/bin/sh
set -eu

root_dir=${0%/*}/..
cd "$root_dir"

case ${1:-asan-ubsan} in
    asan-ubsan)
        cmake --preset asan-ubsan
        cmake --build --preset asan-ubsan
        ctest --preset asan-ubsan
        ;;
    tsan)
        cmake --preset tsan
        cmake --build --preset tsan
        ctest --preset tsan
        ;;
    *)
        echo "usage: bin/sanitize [asan-ubsan|tsan]" >&2
        exit 2
        ;;
esac
